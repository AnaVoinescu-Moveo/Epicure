{
  "kind": "collectionType",
  "collectionName": "restaurants",
  "info": {
    "singularName": "restaurant",
    "pluralName": "restaurants",
    "displayName": "Restaurant",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "rating": {
      "type": "decimal",
      "min": 1,
      "max": 5
    },
    "priceRange": {
      "type": "enumeration",
      "enum": ["low", "medium", "high"]
    },
    "distance": {
      "type": "decimal"
    },
    "isNew": {
      "type": "boolean",
      "default": false
    },
    "popularityScore": {
      "type": "integer",
      "default": 0
    },
    "openingTime": {
      "type": "time"
    },
    "closingTime": {
      "type": "time"
    },
    "latitude": {
      "type": "decimal"
    },
    "longitude": {
      "type": "decimal"
    },
    "chef": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::chef.chef",
      "inversedBy": "restaurants"
    },
    "dishes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::dish.dish",
      "mappedBy": "restaurant"
    }
  }
}

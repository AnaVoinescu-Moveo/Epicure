{
  "name": "strapi",
  "targets": {
    "develop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_PATH=$(pwd)/node_modules npm run develop",
        "cwd": "packages/strapi"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_PATH=$(pwd)/node_modules npm run build",
        "cwd": "packages/strapi"
      }
    }
  }
}